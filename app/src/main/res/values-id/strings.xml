    <string name="daily_tip_label">💡 Tips Hari Ini</string>
    <string name="daily_tip_for">Untuk</string>
    <string-array name="tips_underweight">
        <item>Makan makanan padat kalori seperti kacang-kacangan, alpukat, dan biji-bijian utuh</item>
        <item>Coba makan 5-6 kali porsi kecil per hari daripada 3 kali porsi besar</item>
        <item>Sertakan makanan kaya protein seperti telur, ikan, dan kacang-kacangan di setiap makan</item>
        <item>Latihan kekuatan membantu membangun massa otot yang sehat</item>
        <item>Pantau asupan kalori harian untuk memastikan Anda makan cukup</item>
        <item>Tambahkan lemak sehat seperti minyak zaitun, keju, dan selai kacang ke makanan</item>
        <item>Minum smoothie dan minuman shake kaya kalori sebagai camilan di antara waktu makan</item>
        <item>Hindari minum air sebelum makan karena dapat mengurangi nafsu makan</item>
        <item>Pilih camilan bergizi seperti campuran kacang, yogurt, dan buah kering</item>
        <item>Tidur cukup karena kurang tidur dapat memengaruhi nafsu makan dan metabolisme</item>
    </string-array>
    <string-array name="tips_healthy">
        <item>Pertahankan pola makan seimbang dengan banyak buah dan sayuran</item>
        <item>Tetap aktif dengan setidaknya 150 menit olahraga sedang per minggu</item>
        <item>Minum setidaknya 8 gelas air sehari agar tetap terhidrasi</item>
        <item>Tidur berkualitas 7-9 jam setiap malam</item>
        <item>Pemeriksaan kesehatan rutin membantu mendeteksi masalah lebih awal</item>
        <item>Praktikkan makan dengan penuh perhatian dan perhatikan sinyal lapar dan kenyang</item>
        <item>Batasi makanan olahan dan pilih alternatif alami</item>
        <item>Kelola stres melalui meditasi, yoga, atau latihan pernapasan</item>
        <item>Sertakan berbagai kelompok makanan di setiap makan untuk nutrisi seimbang</item>
        <item>Ambil jeda singkat untuk berjalan jika Anda duduk lama</item>
        <item>Batasi gula tambahan hingga kurang dari 25 gram per hari</item>
        <item>Makan lebih banyak makanan kaya serat seperti gandum, kacang-kacangan, dan roti gandum utuh</item>
        <item>Masak lebih sering di rumah untuk mengontrol bahan dan porsi</item>
        <item>Tetap aktif secara sosial karena hubungan yang kuat meningkatkan kesehatan</item>
        <item>Lindungi kulit dengan tabir surya dan jaga diri di bawah sinar matahari</item>
    </string-array>
    <string-array name="tips_overweight">
        <item>Kurangi ukuran porsi secara bertahap dan gunakan piring yang lebih kecil</item>
        <item>Sertakan lebih banyak makanan kaya serat agar kenyang lebih lama</item>
        <item>Mulailah dengan berjalan 30 menit sehari dan tingkatkan secara bertahap</item>
        <item>Ganti minuman manis dengan air putih, teh herbal, atau air infus</item>
        <item>Simpan jurnal makan untuk menyadari pola makan Anda</item>
        <item>Makan perlahan dan kunyah dengan baik; tubuh butuh 20 menit untuk merasa kenyang</item>
        <item>Rencanakan menu makan sebelumnya untuk menghindari pilihan tidak sehat secara impulsif</item>
        <item>Pilih protein tanpa lemak seperti dada ayam, ikan, dan tahu</item>
        <item>Hindari makan larut malam dan selesaikan makan malam 3 jam sebelum tidur</item>
        <item>Temukan aktivitas fisik yang Anda nikmati seperti menari, berenang, atau bersepeda</item>
        <item>Kurangi karbohidrat olahan seperti roti putih, pasta, dan kue</item>
        <item>Cari teman olahraga karena dukungan sosial meningkatkan motivasi</item>
        <item>Baca label nutrisi untuk membuat pilihan makanan yang tepat</item>
        <item>Gunakan tangga daripada lift bila memungkinkan</item>
        <item>Rayakan pencapaian kecil karena setiap 0,5 kg yang turun adalah kemajuan</item>
    </string-array>
    <string-array name="tips_obese">
        <item>Konsultasikan dengan profesional kesehatan untuk panduan yang dipersonalisasi</item>
        <item>Mulailah dengan olahraga ringan seperti berjalan atau senam air</item>
        <item>Fokus pada makanan utuh dan hindari makanan yang sangat olahan</item>
        <item>Tetapkan tujuan realistis dan targetkan penurunan 0,5 hingga 1 kg per minggu</item>
        <item>Pertimbangkan bekerja sama dengan ahli gizi terdaftar</item>
        <item>Pantau kemajuan secara teratur karena perubahan kecil terakumulasi seiring waktu</item>
        <item>Bangun sistem dukungan dari keluarga dan teman</item>
        <item>Prioritaskan tidur karena kurang tidur meningkatkan hormon lapar</item>
        <item>Kendalikan porsi: setengah sayuran, seperempat protein, seperempat biji-bijian</item>
        <item>Fokus pada membangun kebiasaan sehat daripada diet cepat</item>
    </string-array>
