    <!-- Health Tips -->
    <string name="daily_tip_label">💡 Daily Tip</string>
    <string name="daily_tip_for">For</string>

    <string-array name="tips_underweight">
        <item>Eat calorie-dense foods like nuts, avocados, and whole grains</item>
        <item>Try having 5-6 smaller meals throughout the day instead of 3 large ones</item>
        <item>Include protein-rich foods like eggs, fish, and legumes in every meal</item>
        <item>Strength training can help build healthy muscle mass</item>
        <item>Track your daily calorie intake to ensure you are eating enough</item>
        <item>Add healthy fats like olive oil, cheese, and nut butters to your meals</item>
        <item>Drink smoothies and shakes as calorie-rich snacks between meals</item>
        <item>Avoid drinking water before meals as it can reduce appetite</item>
        <item>Choose nutrient-dense snacks like trail mix, yogurt, and dried fruits</item>
        <item>Get adequate sleep as poor sleep can affect appetite and metabolism</item>
    </string-array>

    <string-array name="tips_healthy">
        <item>Maintain a balanced diet with plenty of fruits and vegetables</item>
        <item>Stay active with at least 150 minutes of moderate exercise per week</item>
        <item>Drink at least 8 glasses of water daily to stay hydrated</item>
        <item>Get 7-9 hours of quality sleep every night</item>
        <item>Regular health checkups help catch problems early</item>
        <item>Practice mindful eating and pay attention to hunger and fullness cues</item>
        <item>Limit processed foods and choose whole, natural alternatives</item>
        <item>Manage stress through meditation, yoga, or deep breathing exercises</item>
        <item>Include a variety of food groups in every meal for balanced nutrition</item>
        <item>Take short walking breaks if you sit for long periods during the day</item>
        <item>Limit added sugar intake to less than 25g per day</item>
        <item>Eat more fiber-rich foods like oats, beans, and whole wheat bread</item>
        <item>Cook more meals at home to control ingredients and portions</item>
        <item>Stay socially active as strong social connections improve health</item>
        <item>Protect your skin with sunscreen and stay safe in the sun</item>
    </string-array>

    <string-array name="tips_overweight">
        <item>Reduce portion sizes gradually and use smaller plates as a visual trick</item>
        <item>Include more fiber-rich foods to help you feel full longer</item>
        <item>Start with 30 minutes of walking daily and gradually increase</item>
        <item>Replace sugary drinks with water, herbal tea, or infused water</item>
        <item>Keep a food journal to become aware of your eating patterns</item>
        <item>Eat slowly and chew thoroughly as it takes 20 minutes to feel full</item>
        <item>Plan your meals ahead to avoid impulsive unhealthy choices</item>
        <item>Choose lean proteins like chicken breast, fish, and tofu</item>
        <item>Avoid eating late at night and try to finish dinner 3 hours before bed</item>
        <item>Find physical activities you enjoy like dancing, swimming, or cycling</item>
        <item>Cut back on refined carbs like white bread, pasta, and pastries</item>
        <item>Get a workout buddy as social support increases motivation</item>
        <item>Read nutrition labels to make informed food choices</item>
        <item>Replace elevator rides with stairs whenever possible</item>
        <item>Celebrate small victories as every 0.5 kg lost is progress</item>
    </string-array>

    <string-array name="tips_obese">
        <item>Consult a healthcare professional for personalized guidance</item>
        <item>Start with gentle exercises like walking or water aerobics</item>
        <item>Focus on whole foods and avoid highly processed foods</item>
        <item>Set realistic goals and aim for 0.5 to 1 kg per week</item>
        <item>Consider working with a registered nutritionist</item>
        <item>Track your progress regularly as small changes add up over time</item>
        <item>Build a support system of family and friends for encouragement</item>
        <item>Prioritize sleep as poor sleep increases hunger hormones</item>
        <item>Practice portion control: half vegetables, quarter protein, quarter grains</item>
        <item>Focus on building healthy habits rather than quick-fix diets</item>
    </string-array>

