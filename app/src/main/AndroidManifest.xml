<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- EPIC-09 T09.2 — androidx.health.connect:connect-client declares minSdk 26, but this
         app supports minSdk 24. Every call site that touches the library is gated behind
         Build.VERSION.SDK_INT >= 26 at runtime (see HealthConnectManager.isAvailable), so
         Android 7.0/7.1 devices simply never reach that code path — they couldn't install the
         Health Connect provider app on that OS version anyway. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- EPIC-09 T09.2 — Health Connect bidirectional weight sync (opt-in, off by default). -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" />

    <!-- Package-visibility (Android 11+): lets HealthConnectClient.getSdkStatus() detect
         whether the Health Connect provider app is installed, for the Settings fallback UI. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Idea I1 — package-visibility (Android 11+) so ActivityResultContracts.TakePicture()
             can resolve a camera app via ACTION_IMAGE_CAPTURE. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".GalaxyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/xml_data_extraction_rules"
        android:fullBackupContent="@xml/xml_backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <!-- AdMob App ID — bắt buộc khai báo qua manifest cho Google Mobile Ads SDK. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3612191981543807~1273576268" />

        <!-- LƯU Ý: AppLovin SDK 13.x (bundle vào AdmobApplovinWrapper 1.1.3+) BẮT BUỘC
             SDK key qua code (AdSdkConfig.applovinSdkKey = BuildConfig.APPLOVIN_SDK_KEY).
             KHÔNG khai báo `applovin.sdk.key` ở đây — sẽ crash IllegalStateException
             "Invalid initialization process" khi SDK init. -->

        <activity
            android:name=".ui.SplashAct"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ResultAct"
            android:exported="false" />

        <activity
            android:name=".ui.MainAct"
            android:exported="false" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CalculatorsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FamilyChallengeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BmrCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TdeeCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.IdealWeightCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BodyFatCalculatorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".feature.vip.VipActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProgressPhotosActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.samsunggalaxy.MainActivity.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_path" />
        </provider>

        <!-- EPIC-09 T09.1 — home-screen widget. exported=true is required so the launcher
             (system UI, a different app/process) can deliver ACTION_APPWIDGET_UPDATE; the
             broadcast itself is OS-protected, so no other app can spoof it despite the export. -->
        <receiver
            android:name=".widget.BmiWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bmi_info" />
        </receiver>

        <!-- Idea I6 — reminder notification's "Log same weight" action button. Only ever
             triggered via our own explicit PendingIntent (not exported), same trust boundary
             as an in-app button click. -->
        <receiver
            android:name=".notification.QuickLogNotificationReceiver"
            android:exported="false" />

    </application>

</manifest>
