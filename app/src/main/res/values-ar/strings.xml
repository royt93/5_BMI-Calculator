    <string-array name="tips_underweight">
        <item>تناول أطعمة غنية بالسعرات كالمكسرات والأفوكادو والحبوب الكاملة</item>
        <item>جرّب تناول 5-6 وجبات صغيرة يومياً بدلاً من 3 وجبات كبيرة</item>
        <item>أضف أطعمة غنية بالبروتين كالبيض والسمك والبقوليات لكل وجبة</item>
        <item>تدريب القوة يساعد على بناء كتلة عضلية صحية</item>
        <item>تتبع استهلاكك اليومي من السعرات للتأكد من أنك تأكل بما يكفي</item>
        <item>أضف دهوناً صحية كزيت الزيتون والجبن وزبدة المكسرات لوجباتك</item>
        <item>اشرب عصائر وشيك غنية بالسعرات كوجبات خفيفة بين الوجبات</item>
        <item>تجنب شرب الماء قبل الوجبات مباشرة لأنه يقلل الشهية</item>
        <item>اختر وجبات خفيفة مغذية كخليط المكسرات والزبادي والفواكه المجففة</item>
        <item>احصل على قسط كافٍ من النوم لأن قلة النوم تؤثر على الشهية والتمثيل الغذائي</item>
    </string-array>
    <string-array name="tips_healthy">
        <item>حافظ على نظام غذائي متوازن غني بالفواكه والخضروات</item>
        <item>كن نشيطاً بممارسة 150 دقيقة على الأقل من التمارين المعتدلة أسبوعياً</item>
        <item>اشرب 8 أكواب من الماء يومياً للبقاء رطباً</item>
        <item>نَم 7 إلى 9 ساعات جيدة كل ليلة</item>
        <item>الفحوصات الطبية المنتظمة تساعد في الكشف المبكر عن المشكلات</item>
        <item>مارس الأكل الواعي وانتبه لإشارات الجوع والشبع</item>
        <item>قلّل الأطعمة المعالجة واختر البدائل الطبيعية</item>
        <item>تحكم في التوتر بالتأمل أو اليوغا أو تمارين التنفس العميق</item>
        <item>أدرج مجموعات غذائية متنوعة في كل وجبة لتحقيق تغذية متوازنة</item>
        <item>خذ فترات راحة قصيرة للمشي إذا جلست لفترات طويلة</item>
        <item>قلل السكر المضاف إلى أقل من 25 جرام يومياً</item>
        <item>تناول المزيد من الأطعمة الغنية بالألياف كالشوفان والفاصوليا وخبز القمح الكامل</item>
        <item>اطبخ في المنزل أكثر للتحكم في المكونات والحصص</item>
        <item>كن نشطاً اجتماعياً لأن العلاقات الصحية تحسّن الصحة العامة</item>
        <item>احمِ بشرتك من الشمس باستخدام واقٍ شمسي</item>
    </string-array>
    <string-array name="tips_overweight">
        <item>قلّل أحجام الحصص تدريجياً واستخدم أطباقاً أصغر</item>
        <item>أضف المزيد من الأطعمة الغنية بالألياف لتشعر بالشبع لفترة أطول</item>
        <item>ابدأ بالمشي 30 دقيقة يومياً وزد المدة تدريجياً</item>
        <item>استبدل المشروبات السكرية بالماء أو الشاي الأعشاب أو الماء المنكه</item>
        <item>احتفظ بمفكرة طعام لتكون واعياً بعاداتك الغذائية</item>
        <item>تناول ببطء وامضغ جيداً؛ يحتاج الجسم 20 دقيقة للشعور بالشبع</item>
        <item>خطط لوجباتك مسبقاً لتجنب الاختيارات المندفعة غير الصحية</item>
        <item>اختر بروتيناً قليل الدهون كصدر الدجاج والسمك والتوفو</item>
        <item>تجنب الأكل في وقت متأخر من الليل وأنهِ العشاء قبل 3 ساعات من النوم</item>
        <item>ابحث عن أنشطة بدنية تستمتع بها كالرقص أو السباحة أو ركوب الدراجة</item>
        <item>قلّل الكربوهيدرات المكررة كالخبز الأبيض والمعكرونة والحلويات</item>
        <item>ابحث عن شريك رياضي لأن الدعم الاجتماعي يزيد الدافعية</item>
        <item>اقرأ بطاقات التغذية لاتخاذ خيارات غذائية مدروسة</item>
        <item>استخدم السلم بدلاً من المصعد كلما أمكن</item>
        <item>احتفل بالإنجازات الصغيرة؛ كل 0.5 كجم خسرته يُعدّ تقدماً حقيقياً</item>
    </string-array>
    <string-array name="tips_obese">
        <item>استشر متخصصاً في الرعاية الصحية للحصول على توجيه شخصي</item>
        <item>ابدأ بتمارين خفيفة كالمشي أو الرياضة المائية</item>
        <item>ركّز على الأطعمة الطبيعية وتجنب الأطعمة شديدة المعالجة</item>
        <item>ضع أهدافاً واقعية واستهدف فقدان 0.5 إلى 1 كجم أسبوعياً</item>
        <item>فكّر في العمل مع أخصائي تغذية معتمد</item>
        <item>تتبع تقدمك بانتظام؛ التغييرات الصغيرة تتراكم بمرور الوقت</item>
        <item>أنشئ شبكة دعم من العائلة والأصدقاء</item>
        <item>أعطِ النوم الأولوية لأن قلته تزيد هرمونات الجوع</item>
        <item>تحكم في الحصص: نصف الطبق خضروات، ربع بروتين، ربع حبوب</item>
        <item>ركّز على بناء عادات صحية بدلاً من الحميات السريعة</item>
    </string-array>
