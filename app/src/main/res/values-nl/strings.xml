    <string-array name="tips_underweight">
        <item>Eet caloriërijke voeding zoals noten, avocado\'s en volkorenproducten</item>
        <item>Probeer 5-6 kleine maaltijden per dag te eten in plaats van 3 grote</item>
        <item>Voeg eiwitrijke voeding toe zoals eieren, vis en peulvruchten bij elke maaltijd</item>
        <item>Krachttraining helpt bij het opbouwen van gezonde spiermassa</item>
        <item>Houd uw dagelijkse calorie-inname bij om er zeker van te zijn dat u genoeg eet</item>
        <item>Voeg gezonde vetten toe zoals olijfolie, kaas en notenboter aan maaltijden</item>
        <item>Drink calorierijke smoothies en shakes als tussendoortje</item>
        <item>Vermijd water drinken vlak voor maaltijden want dit vermindert de eetlust</item>
        <item>Kies voor voedzame snacks zoals notenmengsels, yoghurt en gedroogd fruit</item>
        <item>Slaap voldoende; slechte slaap beïnvloedt eetlust en stofwisseling</item>
    </string-array>
    <string-array name="tips_healthy">
        <item>Houd een evenwichtig dieet aan met veel fruit en groenten</item>
        <item>Blijf actief met minimaal 150 minuten matige beweging per week</item>
        <item>Drink minimaal 8 glazen water per dag om gehydrateerd te blijven</item>
        <item>Slaap elke nacht 7-9 uur kwalitatief goed</item>
        <item>Regelmatige gezondheidscontroles helpen problemen vroeg op te sporen</item>
        <item>Oefen mindful eten en let op honger- en verzadigingssignalen</item>
        <item>Beperk bewerkte voeding en kies voor natuurlijke alternatieven</item>
        <item>Beheers stress via meditatie, yoga of diepe ademhalingsoefeningen</item>
        <item>Neem diverse voedselgroepen op in elke maaltijd voor evenwichtige voeding</item>
        <item>Neem korte wandelpauzes als u lang zit</item>
        <item>Beperk toegevoegde suiker tot minder dan 25 g per dag</item>
        <item>Eet meer vezelrijke voeding zoals haver, bonen en volkorenbrood</item>
        <item>Kook vaker thuis om ingrediënten en porties te beheersen</item>
        <item>Blijf sociaal actief; sterke sociale banden verbeteren de gezondheid</item>
        <item>Bescherm uw huid met zonnebrandcrème in de zon</item>
    </string-array>
    <string-array name="tips_overweight">
        <item>Verklein porties geleidelijk en gebruik kleinere borden als visuele truc</item>
        <item>Neem meer vezelrijke voeding op om langer verzadigd te blijven</item>
        <item>Begin met 30 minuten wandelen per dag en bouw geleidelijk op</item>
        <item>Vervang suikerhoudende dranken door water, kruidenthee of fruitwater</item>
        <item>Houd een eetdagboek bij om bewust te worden van uw eetgewoonten</item>
        <item>Eet langzaam en kauw goed; het duurt 20 minuten voor het verzadigingssignaal aankomt</item>
        <item>Plan maaltijden van tevoren om impulsieve ongezonde keuzes te vermijden</item>
        <item>Kies magere eiwitten zoals kipfilet, vis en tofu</item>
        <item>Vermijd laat eten en sluit het avondeten 3 uur voor bedtijd af</item>
        <item>Vind lichamelijke activiteiten die u leuk vindt zoals dansen, zwemmen of fietsen</item>
        <item>Verminder geraffineerde koolhydraten zoals witbrood, pasta en gebak</item>
        <item>Zoek een trainingspartner; sociale steun verhoogt motivatie</item>
        <item>Lees voedingsetiketten voor bewuste voedingskeuzes</item>
        <item>Gebruik de trap in plaats van de lift waar mogelijk</item>
        <item>Vier kleine successen; elke 0,5 kg minder is echte vooruitgang</item>
    </string-array>
    <string-array name="tips_obese">
        <item>Raadpleeg een zorgprofessional voor persoonlijk advies</item>
        <item>Begin met lichte beweging zoals wandelen of aquarobics</item>
        <item>Focus op onbewerkte voeding en vermijd sterk bewerkte producten</item>
        <item>Stel realistische doelen; streef naar 0,5-1 kg per week</item>
        <item>Overweeg samen te werken met een geregistreerde diëtist</item>
        <item>Volg uw voortgang regelmatig; kleine veranderingen stapelen zich op</item>
        <item>Bouw een ondersteuningsnetwerk op met familie en vrienden</item>
        <item>Geef prioriteit aan slaap; slechte slaap verhoogt hongerhormonen</item>
        <item>Beheers porties: helft groenten, kwart eiwit, kwart granen</item>
        <item>Focus op het opbouwen van gezonde gewoonten in plaats van sneldiëten</item>
    </string-array>
